cmd_verify() {
  log "Verifying deterministic seed data in container filesystem"
  docker exec -i "$CONTAINER_NAME" sh -s <<'EOF'
set -eu
test -f "/srv/.tester-env-seed-version"
grep -q "filebrowser tester-env seed v1" "/srv/.tester-env-seed-version"
test -d "/srv/00_Inbox"
test -d "/srv/01_Projects/Atlas_Redesign/assets"
test -d "/srv/01_Projects/Beacon_Mobile_App/screenshots"
test -d "/srv/02_Finance/2026-Q2"
test -d "/srv/Client Contracts"
test -f "/srv/README.md"
test -f "/srv/team-roster.csv"
test -f "/srv/01_Projects/Atlas_Redesign/brief.md"
test -f "/srv/01_Projects/Atlas_Redesign/assets/logo-moodboard.svg"
test -f "/srv/02_Finance/2026-Q2/invoices-april.csv"
test -f "/srv/Client Contracts/Nimbus-SOW.txt"
grep -q "Northwind Design Studio Shared Drive" "/srv/README.md"
grep -q "Atlas Redesign Brief" "/srv/01_Projects/Atlas_Redesign/brief.md"
grep -q "BC-2201,Beacon Labs,6400.00,sent,2026-04-28" "/srv/02_Finance/2026-Q2/invoices-april.csv"
grep -q "Status: signed" "/srv/Client Contracts/Nimbus-SOW.txt"
[ "$(find /srv -type f | wc -l | tr -d ' ')" = "17" ]
  [ "$(find /srv -type d | wc -l | tr -d ' ')" = "12" ]
[ "$(find /srv -mindepth 1 -maxdepth 1 | wc -l | tr -d ' ')" = "8" ]
EOF
  log "Seed verification passed"
}

cmd_stop() {
  log "Stopping container, preserving volumes"
  docker stop "$CONTAINER_NAME"
}

cmd_status() {
  docker ps -a --filter "name=^/${CONTAINER_NAME}$" --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
  if curl -fsS "http://localhost:$PORT/health" >/dev/null 2>&1; then
    log "HTTP OK: http://localhost:$PORT"
  else
    log "HTTP not responding: http://localhost:$PORT"
    return 1
  fi
}

cmd_logs() {
  docker logs -f "$CONTAINER_NAME"
}

cmd_help() {
  cat <<EOF
Usage: ./tester-env <command>

Commands:
  deploy   Build editable source with Docker and start Filebrowser
  seed     Populate deterministic realistic file repository data
  verify   Check deterministic seed data in the container filesystem
  reset    Stop/remove container and remove config, database, and root volumes
  stop     Stop container but preserve volumes
  status   Show container state and check /health
  logs     Follow container logs
  help     Show this help

Environment:
  FILEBROWSER_PORT=$PORT
  FILEBROWSER_ADMIN_USERNAME=$ADMIN_USERNAME
  FILEBROWSER_ADMIN_PASSWORD=$ADMIN_PASSWORD
EOF
}

case "${1:-help}" in
  deploy) cmd_deploy ;;
  seed) cmd_seed ;;
  verify) cmd_verify ;;
  reset) cmd_reset ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  logs) cmd_logs ;;
  help|-h|--help) cmd_help ;;
  *) cmd_help; exit 2 ;;
esac
