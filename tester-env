#!/usr/bin/env bash
set -euo pipefail

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE_NAME="${FILEBROWSER_IMAGE:-tester-env-filebrowser}"
CONTAINER_NAME="${FILEBROWSER_CONTAINER:-tester-env-filebrowser}"
PORT="${FILEBROWSER_PORT:-8080}"
CONFIG_VOLUME="${FILEBROWSER_CONFIG_VOLUME:-tester-env-filebrowser-config}"
DATABASE_VOLUME="${FILEBROWSER_DATABASE_VOLUME:-tester-env-filebrowser-database}"
ROOT_VOLUME="${FILEBROWSER_ROOT_VOLUME:-tester-env-filebrowser-root}"
ADMIN_USERNAME="${FILEBROWSER_ADMIN_USERNAME:-admin}"
ADMIN_PASSWORD="${FILEBROWSER_ADMIN_PASSWORD:-adminadminadmin}"
DEFAULT_ADMIN_PASSWORD_HASH='$2b$10$Z51ThZo1nDeKdb5D3rhfEOB29FbSjz45a9MH68IjjvKkzQ7y3fULe'
ADMIN_PASSWORD_HASH="${FILEBROWSER_ADMIN_PASSWORD_HASH:-$DEFAULT_ADMIN_PASSWORD_HASH}"
SEED_MARKER="/srv/.tester-env-seed-version"

log() { printf '==> %s\n' "$*"; }

source_ref() {
  git -C "$APP_DIR" rev-parse HEAD
}

cmd_deploy() {
  local ref
  ref="$(source_ref)"
  log "Building $IMAGE_NAME from source ref $ref"
  docker build \
    -f "$APP_DIR/Dockerfile.tester-env" \
    --build-arg COMMIT="$ref" \
    --build-arg VERSION="tester-env" \
    -t "$IMAGE_NAME" \
    "$APP_DIR"

  log "Removing existing container if present"
  docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true

  log "Starting http://localhost:$PORT with $ADMIN_USERNAME/$ADMIN_PASSWORD"
  docker run -d \
    --name "$CONTAINER_NAME" \
    -p "$PORT:80" \
    -v "$CONFIG_VOLUME:/config" \
    -v "$DATABASE_VOLUME:/database" \
    -v "$ROOT_VOLUME:/srv" \
    "$IMAGE_NAME" \
    --address 0.0.0.0 \
    --port 80 \
    --root /srv \
    --database /database/filebrowser.db \
    --username "$ADMIN_USERNAME" \
    --password "$ADMIN_PASSWORD_HASH"

  log "Waiting for HTTP health endpoint"
  for _ in {1..60}; do
    if curl -fsS "http://localhost:$PORT/health" >/dev/null; then
      log "Ready: http://localhost:$PORT"
      return 0
    fi
    sleep 1
  done

  log "Container did not become healthy"
  docker logs "$CONTAINER_NAME" || true
  return 1
}

cmd_reset() {
  log "Removing container and data volumes"
  docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
  docker volume rm "$CONFIG_VOLUME" "$DATABASE_VOLUME" "$ROOT_VOLUME" >/dev/null 2>&1 || true
}

